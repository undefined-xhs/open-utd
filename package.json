{
  "name": "open-utd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "data:export": "python3 scripts/cli.py export --out .generated",
    "dev": "npm run data:export && python3 scripts/fetch_comments.py --ensure-empty && astro dev",
    "build": "npm run data:export && python3 scripts/fetch_comments.py --ensure-empty && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test:site": "node scripts/check_site.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
