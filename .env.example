# Copy to .env for Astro. Python commands need exported shell variables.
# Use a real maintainer contact for network requests; this is not needed for demo.
CROSSREF_MAILTO=

# Reserved for an optional future integration. Not read by scheduled Crossref sync.
# Never use a PUBLIC_ prefix for an API key.
OPENALEX_API_KEY=

# Public configuration from https://giscus.app/; leave blank until installed.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# Public site token from the Cloudflare Web Analytics beacon, not an API token.
# Leave blank to disable. Only production builds with production data load it.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Server-side public analytics snapshots; export these for the Python collector.
# Use an Account Analytics:Read API token only, stored as an Actions Secret.
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=

# Local preview. Actions derives the GitHub Pages defaults when these are unset.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_BASE_PATH=/

# Keep synthetic development data separate from the tracked production snapshot.
AJR_ENV=demo
AJR_DB_PATH=.local/demo.sqlite
