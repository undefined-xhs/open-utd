---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {getManifest,getJournal} from '../../../lib/catalog';
import {href,reviewsUrl,yearUrl,onlineFirstUrl,safeExternal} from '../../../lib/urls';
import {number} from '../../../lib/formatting';
import {copy} from '../../../lib/copy';
export function getStaticPaths() { return getManifest().journals.map(j=>({params:{slug:j.slug},props:{id:j.public_id}})); }
const journal = getJournal(Astro.props.id);
const groups = new Map<string,{issues:number;articles:number}>();
for(const issue of journal.issues) {
  const year = issue.publication_year ? String(issue.publication_year) : 'undated';
  const group=groups.get(year) || {issues:0,articles:0};
  group.issues++;group.articles+=issue.article_count;groups.set(year,group);
}
const years=[...groups.entries()].sort(([a],[b])=>a==='undated'?1:b==='undated'?-1:Number(b)-Number(a));
const official=safeExternal(journal.homepage_url);
---
<BaseLayout originalTitle title={journal.name} description={`Browse ${journal.name} by year, find articles, or join its independent reviews and submission experiences.`}>
  <div class="container archive-page" data-review-url={reviewsUrl(journal)}>
    <Breadcrumbs items={[{label:copy.common.journals,url:href('journals/')},{label:journal.name,original:true}]} />
    <header class="page-intro compact-intro" data-pagefind-body>
      <span class="eyebrow" data-pagefind-filter="type">Journal</span>
      <h1 data-original lang="en" class="journal-title" data-pagefind-meta="title" data-pagefind-filter="journal">{journal.name}</h1>
      <p class="journal-subtitle"><span data-original>{journal.publisher}</span>{journal.abbreviation && <span data-original>{journal.abbreviation}</span>}</p>
      <span class="sr-only" data-original>{journal.issns.join(' ')} {journal.subject}</span>
      <div class="article-actions" data-pagefind-ignore><a class="button" href={reviewsUrl(journal)}>Reviews & submission experiences →</a>{official && <a class="text-link" href={official} target="_blank" rel="noopener noreferrer">{copy.common.official} ↗</a>}</div>
    </header>
    <section class="year-section" id="issues">
      <div class="section-heading"><div><h2>Browse by year</h2><p>Select a year to see its issues.</p></div></div>
      {years.length ? <div class="year-grid">{years.map(([year,group])=><a class="year-card" href={yearUrl(journal,year)}><span class="year-card-title">{year==='undated'?'Year not recorded':year}</span><span class="year-card-count">{number(group.issues)} issues <span aria-hidden="true">→</span></span></a>)}</div> : <p class="empty-state">{copy.common.noIssues}</p>}
    </section>
    <a class="online-link" href={onlineFirstUrl(journal)}><span>{copy.common.online}</span><span>{number(journal.online_first.length)} articles <span aria-hidden="true">→</span></span></a>
    <p class="archive-note">{copy.common.coverage} <a class="text-link" href={href('data-sources/')}>Data & sources →</a></p>
  </div>
</BaseLayout>
<script>
  // Keep older bookmarks working after the journal discussion moved to its own page.
  const reviewUrl=document.querySelector<HTMLElement>('[data-review-url]')?.dataset.reviewUrl;
  const followLegacyReview=()=>{if(location.hash==='#reviews' && reviewUrl)location.replace(reviewUrl);};
  followLegacyReview();window.addEventListener('hashchange',followLegacyReview);
</script>
