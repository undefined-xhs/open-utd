---
import { href } from '../lib/urls';
interface Props { items: {label:string; url?:string; original?:boolean}[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
  <a href={href()}>Home</a>
  {items.map(item => <><span aria-hidden="true">/</span>{item.url ? <a href={item.url} data-original={item.original}>{item.label}</a> : <span data-original={item.original} class="current" aria-current="page">{item.label}</span>}</>)}
</nav>
