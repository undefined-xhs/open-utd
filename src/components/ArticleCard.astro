---
import type { Article } from '../lib/types';
import { articleUrl, doiUrl } from '../lib/urls';
import { date } from '../lib/formatting';
import { copy } from '../lib/copy';
interface Props {article:Article;}
const {article} = Astro.props;
const doi = doiUrl(article.doi);
---
<article class="article-card">
  <h3 data-original><a href={articleUrl(article.public_id)}>{article.title}</a></h3>
  <p class="article-authors" data-original={article.authors.length > 0 || undefined}>{article.authors.map(author=>author.byline_name || author.display_name).join(' · ') || 'Authors not recorded'}</p>
  <div class="article-card-actions"><a class="text-link" href={`${articleUrl(article.public_id)}#discussion`}>Discuss this article →</a></div>
  <div class="article-meta">{article.publication_date && <time datetime={article.publication_date}>{date(article.publication_date)}</time>}{article.pages && <span>pp. {article.pages}</span>}{doi && <a data-original href={doi} target="_blank" rel="noopener noreferrer">DOI: {article.doi} ↗</a>}</div>
  {article.abstract_display_status === 'permitted' && article.abstract_text ? <details><summary>{copy.common.abstract}</summary><p data-original lang="en">{article.abstract_text}</p></details> : null}
</article>
